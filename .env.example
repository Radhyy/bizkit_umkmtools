# ==============================================================================
# BIZKIT - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Ganti nilai di bawah ini dengan kredensial Anda sebelum menjalankan aplikasi.
# JANGAN PERNAH MENGUNGGAH FILE .env DENGAN KREDENSIAL ASLI KE REPOSITORI PUBLIK!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=public
DATABASE_URL="postgresql://postgres:password123@localhost:5432/bizkit_db?schema=public"

# (Opsional) Cadangan Database Cloud (misal: Neon / Supabase)
# DATABASE_URL_CLOUD="postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. EMAIL SMTP CONFIGURATION (Nodemailer - Verifikasi OTP & Notifikasi)
# ------------------------------------------------------------------------------
# Gunakan akun Gmail dengan App Password (bukan password akun biasa)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="xxxx yyyy zzzz wwww"

# ------------------------------------------------------------------------------
# 3. GROQ AI ENGINE (Asisten AI, Analisis Tren & AI Page Builder)
# ------------------------------------------------------------------------------
# Kunci API Groq (pisahkan dengan koma untuk fitur multi-key failover & load balancer)
GROQ_API_KEYS="gsk_sampleKey1xxxxxxxxxxxxxxxxxxxx,gsk_sampleKey2xxxxxxxxxxxxxxxxxxxx"
GROQ_DEFAULT_MODEL="qwen/qwen3.8-27b"

# ------------------------------------------------------------------------------
# 4. WHATSAPP AI BOT - DEDICATED GROQ API POOL
# ------------------------------------------------------------------------------
# Kunci API khusus bot WhatsApp agar kuota terpisah dari web dashboard
GROQ_WA_API_KEYS="gsk_waKey1xxxxxxxxxxxxxxxxxxxx,gsk_waKey2xxxxxxxxxxxxxxxxxxxx"
GROQ_WA_MODEL="qwen/qwen3.8-27b"

# ------------------------------------------------------------------------------
# 5. AI IMAGE GENERATION (Pembuatan Gambar Produk & Banner)
# ------------------------------------------------------------------------------
IMAGE_GEN_KEYS="sk-sampleImageGenKeyxxxxxxxxxxxxxxxx"
IMAGE_GEN_MODEL="ag/gemini-3.1-flash-image"

# ------------------------------------------------------------------------------
# 6. MIDTRANS PAYMENT GATEWAY (Paket Langganan UMKM)
# ------------------------------------------------------------------------------
# Dapatkan dari dashboard Midtrans (Settings > Access Keys)
MIDTRANS_SERVER_KEY="Mid-server-sampleServerKeyxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-sampleClientKeyxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-sampleClientKeyxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false" # Set "true" untuk production, "false" untuk sandbox

# ------------------------------------------------------------------------------
# 7. S3 OBJECT STORAGE (Penyimpanan Foto Produk, Logo & Banner)
# ------------------------------------------------------------------------------
# Kompatibel dengan AWS S3 / KilatStorage / Cloudflare R2 / MinIO
S3_ACCESS_KEY_ID="sample_access_key_id"
S3_SECRET_ACCESS_KEY="sample_secret_access_key"
S3_ENDPOINT="https://s3-id-jkt-1.kilatstorage.id"
S3_BUCKET_NAME="your-bucket-name"
S3_REGION="id-jkt-1"

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH 2.0 (Login dengan Akun Google)
# ------------------------------------------------------------------------------
# Dapatkan dari Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID="sample-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-sampleClientSecretxxxxxxxxx"

# ------------------------------------------------------------------------------
# 9. APP DOMAIN / BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
